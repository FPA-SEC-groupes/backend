# Copier ce fichier en .env (jamais versionné) et remplir les valeurs.
DB_URL=jdbc:mysql://localhost:3306/helloway?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# Au moins 64 caractères aléatoires (HS512). Exemple : openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Compte d'envoi des e-mails (mot de passe d'application Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Chemin du fichier JSON du compte de service Firebase (hors Git)
FIREBASE_CREDENTIALS=secrets/firebase-adminsdk.json

# Origines web autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000

# Premier compte admin (créé au démarrage si aucun admin n'existe)
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
